      "higher_cutoff_freq": 18000,
      "method": "pipewire",
      "source": "auto",
      "stereo": true,
      "reverse": true,
      "bar_delimiter": 0,
      "monstercat": false,
      "noise_reduction": 0.1,
      "input_delay": 2,
      "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
      "on-click": "playerctl play-pause",
      "exec": "playerctl metadata --format='{{ title }}'"
  },
  "pulseaudio": {
      // "scroll-step": 1, // %, can be a float
      "format": "{icon} {volume}%",
      "format-muted": " ",
      "format-icons": {
          "default": [" ", " ", "  "]
      },
      "on-click": "kitty --class mixer pulsemixer"
  },
  "tray": {
      "icon-size": 21,
      "spacing": 10
  }, 

  "custom/weather": {
    "format": "{}°",
    "interval": 900,
    "exec": "wttrbar --nerd",
    "return-type": "json",
    "on-click": "kweather --class weather"
  },
  "hyprland/window": {
    "format": "{class} — {title}",
    "icon": false,
    "rewrite": {
      " — ": "",
      "(.*) — Mozilla Firefox": "$1",
      "firefox — (.*)": "  $1",
      "kitty — (.*)": "  $1",
      "(.*) — nvim(.*)": "  $2",
      "org.kde.dolphin — (.*) — Dolphin": "  $1"
    }
  },
  "hyprland/workspaces": {
    "format": "<b>{name}</b> {windows}",
    "workspace-taskbar":  {
      "enable": false,
      "format": "{icon}",
      "icon-theme": ["breeze-dark"]
    },
    "show-special":true,
    "window-rewrite-default": "",
    "window-rewrite": {
      "class<firefox>": " ",
      "class<kitty>": " ",
      "title<nvim.*>": " ",
      "class<.*.exe*>": "",
      "class<net.lutris.Lutris>": "",
      "class<steam>": " ",
      "class<REAPER>": " ",
      "class<org.kde.dolphin>": " ",
      "class<mixer>": " ",
      "class<btop>": "󰄪 ",
      "class<discord>": " " 
    },
    "format-icons": {
      "1": "",
      "2": " ",
      "3": " ",
      "default": ""
    },
    "persistent-workspaces": {
      "*": 3 
    }
  },


  "custom/music": {
      "format": "  {}",
      "escape": true,
      "interval": 1,
      "tooltip": false,
      "exec": "playerctl metadata --format='{{ title }}'",
      "on-click": "playerctl play-pause",
      "max-length": 30
  },
  "custom/updates": {
    "format": "{} {icon}",
    "return-type": "json",
    "format-icons": {
        "has-updates": "󰇚 ",
        "updated": "󰗠 "
    },
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 300 --no-zero-output",
    "on-click": "kitty --class yay yay -Syu"
  },
  "cpu": {
    "interval": 1,
